<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rankai.mini-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>browser_agent.sweep</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ignitesystems/dev/rank-ai</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>11</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/ignitesystems/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/ignitesystems</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/rankai-mini-sweep.log</string>
  <key>StandardErrorPath</key><string>/tmp/rankai-mini-sweep.log</string>
</dict>
</plist>
