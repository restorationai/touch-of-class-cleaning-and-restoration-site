---
// Case studies index (Santino 2026-09-05): browsable proof — real jobs from
// the crew hub + client write-ups. City chips filter client-side; every
// card names city + services so a visitor finds "a job like mine" fast.
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CtaBanner from "~/components/CtaBanner.astro";
import { brand } from "~/lib/brand";

const studies = (await getCollection("caseStudies"))
  .sort((a, b) => (b.data.published_at || "").localeCompare(a.data.published_at || ""));
const cities = [...new Set(studies.map((s) => s.data.city).filter(Boolean))] as string[];
const heroImage = "/images/hero-bg.webp";
const title = `Case Studies | Real ${brand.primaryCity} Jobs by ${brand.displayName}`;
const meta = `Real projects completed by ${brand.displayName}: what happened, what we did, and how it turned out. Photos and details from actual jobs in ${brand.primaryCity} and surrounding areas.`;
const breadcrumb = [{ name: "Home", url: "/" }, { name: "Case Studies" }];
---

<BaseLayout
  title={title}
  meta_description={meta}
  hero_image_url={heroImage}
  schema_stubs={["website", "breadcrumb-list"]}
  schema_ctx={{ archetype: "case-study-index" }}
  breadcrumb={breadcrumb}
>
  <section class="relative min-h-[350px] flex items-center overflow-hidden bg-navy border-b border-white/10">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt="" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/90 to-navy/60"></div>
    </div>
    <div class="container-wide relative z-10 py-16">
      <div class="max-w-2xl">
        <div class="eyebrow">Our Work</div>
        <h1>Real Jobs. Real Results.</h1>
        <p class="text-lg text-white/85 mt-6 mb-0 leading-relaxed">Every case study below is a real project our crew completed, told the way it happened.</p>
      </div>
    </div>
  </section>

  <section class="section-first bg-navy pb-24">
    <div class="container-wide">
      {cities.length > 1 && (
        <div class="flex flex-wrap gap-2 mb-8" id="city-filter">
          <button data-city="" class="px-4 py-1.5 rounded-full border border-primary/60 bg-primary/20 text-white text-xs font-bold uppercase tracking-wide">All cities</button>
          {cities.map((c) => (
            <button data-city={c} class="px-4 py-1.5 rounded-full border border-white/15 text-white/70 text-xs font-bold uppercase tracking-wide hover:border-primary/60">{c}</button>
          ))}
        </div>
      )}
      {studies.length === 0 && (
        <p class="text-white/60">Case studies are on the way — our crews document real jobs as they finish them.</p>
      )}
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {studies.map((s) => (
          <a href={`/case-studies/${s.slug}/`} data-card-city={s.data.city || ""} class="group block rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 hover:border-primary/40 transition-all overflow-hidden no-underline">
            {s.data.hero && (
              <div class="aspect-[16/9] overflow-hidden bg-navy-900">
                <img src={s.data.hero} alt={s.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            )}
            <div class="p-6">
              <div class="text-xs font-black uppercase tracking-widest text-primary-200 mb-3">
                {[s.data.city, s.data.state].filter(Boolean).join(", ") || new Date(s.data.published_at).toLocaleDateString("en-US", { year: "numeric", month: "long" })}
              </div>
              <h2 class="text-xl text-white mt-0 mb-3 leading-snug">{s.data.title}</h2>
              <p class="text-sm text-white/65 mb-0 leading-relaxed">{s.data.meta_description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const filter = document.getElementById("city-filter");
    if (filter) {
      filter.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest("button[data-city]") as HTMLElement | null;
        if (!btn) return;
        const want = btn.dataset.city || "";
        filter.querySelectorAll("button").forEach((b) => {
          b.classList.toggle("border-primary/60", b === btn);
          b.classList.toggle("bg-primary/20", b === btn);
        });
        document.querySelectorAll<HTMLElement>("[data-card-city]").forEach((card) => {
          card.style.display = !want || card.dataset.cardCity === want ? "" : "none";
        });
      });
    }
  </script>

  <CtaBanner heading="Have a job like these?" subheading="We answer the phone 24/7." />
</BaseLayout>
