{
  "name": "ServiceAreaPage",
  "path_pattern": "/service-areas/{area.slug}/",
  "driver": "service_areas[]",
  "title_template": "Restoration Services in {area.city}, {area.state} | {brand.display_name}",
  "h1_template": "Restoration Services in {area.city}",
  "meta_description_template": "Serving {area.city}, {area.state} with 24/7 water, fire, mold, and storm damage restoration. IICRC-certified team. Call {brand.phone}.",
  "primary_keyword_template": "restoration services {area.city|lower}",
  "secondary_keywords": [
    "{area.city|lower} restoration company",
    "damage restoration {area.city|lower}",
    "{area.city|lower} disaster restoration"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 900,
  "image_roles": ["hero", "og", "inline-1"],
  "schema_stubs": ["local-business", "service", "breadcrumb-list"],
  "linking_rules_ref": "service-area",
  "required_brand_fields": ["display_name", "phone"]
}
