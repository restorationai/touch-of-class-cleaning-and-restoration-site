{
  "name": "BlogIndex",
  "fixed_ref": "blog-index",
  "path_pattern": "/blog/",
  "title_template": "Restoration Blog | {brand.display_name}",
  "h1_template": "Restoration Resources and Insights",
  "meta_description_template": "Guides, checklists, and explainers from {brand.display_name} on water, fire, mold, and storm damage restoration.",
  "primary_keyword_template": "restoration blog {brand.primary_city|lower}",
  "secondary_keywords": [
    "restoration guides",
    "damage restoration tips",
    "restoration insights"
  ],
  "search_intent_default": "informational_browse",
  "target_word_count": 300,
  "image_roles": ["hero", "og"],
  "schema_stubs": ["website", "breadcrumb-list"],
  "linking_rules_ref": "blog-index",
  "required_brand_fields": ["display_name"]
}
