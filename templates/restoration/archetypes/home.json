{
  "name": "Home",
  "fixed_ref": "home",
  "path_pattern": "/",
  "title_template": "{brand.display_name} | Restoration Services in {brand.primary_city}, {brand.primary_state}",
  "h1_template": "24/7 Restoration Services in {brand.primary_city}",
  "meta_description_template": "{brand.display_name} provides 24/7 water, fire, mold, and storm damage restoration across {brand.primary_city} and surrounding areas. Licensed, insured, IICRC-certified. Call {brand.phone}.",
  "primary_keyword_template": "restoration services {brand.primary_city|lower}",
  "secondary_keywords": [
    "restoration company near me",
    "24/7 damage restoration",
    "emergency restoration"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 1200,
  "image_roles": ["hero", "og", "inline-1", "inline-2", "inline-3"],
  "schema_stubs": ["organization", "website", "local-business", "aggregate-rating"],
  "linking_rules_ref": "home",
  "required_brand_fields": ["display_name", "phone", "primary_city", "primary_state"]
}
