{
  "name": "BlogIndex",
  "fixed_ref": "blog-index",
  "path_pattern": "/blog/",
  "title_template": "Environmental Testing Blog | {brand.display_name}",
  "h1_template": "Environmental Testing Resources and Insights",
  "meta_description_template": "Guides, checklists, and explainers from {brand.display_name} on mold, indoor air quality, asbestos, lead, radon, and water testing.",
  "primary_keyword_template": "environmental testing blog {brand.primary_city|lower}",
  "secondary_keywords": [
    "environmental testing guides",
    "indoor air quality tips",
    "mold testing insights"
  ],
  "search_intent_default": "informational_browse",
  "target_word_count": 300,
  "image_roles": ["hero", "og"],
  "schema_stubs": ["website", "breadcrumb-list"],
  "linking_rules_ref": "blog-index",
  "required_brand_fields": ["display_name"]
}
