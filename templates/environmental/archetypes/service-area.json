{
  "name": "ServiceAreaPage",
  "path_pattern": "/service-areas/{area.slug}/",
  "driver": "service_areas[]",
  "title_template": "Environmental Testing in {area.city}, {area.state} | {brand.display_name}",
  "h1_template": "Environmental Testing in {area.city}",
  "meta_description_template": "Serving {area.city}, {area.state} with independent mold, air quality, asbestos, lead, and water testing. Certified inspectors, accredited labs. Call {brand.phone}.",
  "primary_keyword_template": "environmental testing {area.city|lower}",
  "secondary_keywords": [
    "{area.city|lower} environmental testing company",
    "mold testing {area.city|lower}",
    "{area.city|lower} air quality testing"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 900,
  "image_roles": ["hero", "og", "inline-1"],
  "schema_stubs": ["local-business", "service", "breadcrumb-list"],
  "linking_rules_ref": "service-area",
  "required_brand_fields": ["display_name", "phone"]
}
