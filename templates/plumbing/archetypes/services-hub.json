{
  "name": "ServicesHub",
  "fixed_ref": "services-hub",
  "path_pattern": "/services/",
  "title_template": "Plumbing, Heating & Air Services in {brand.primary_city} | {brand.display_name}",
  "h1_template": "Our Plumbing, Heating and Air Services",
  "meta_description_template": "Full-service plumbing and HVAC in {brand.primary_city}: drains, water heaters, sewer lines, gas lines, furnaces, and air conditioning. Call {brand.phone} for 24/7 emergency service.",
  "primary_keyword_template": "plumbing services {brand.primary_city|lower}",
  "secondary_keywords": [
    "plumbing services",
    "hvac services",
    "heating and cooling services"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 800,
  "image_roles": ["hero", "og", "inline-1"],
  "schema_stubs": ["organization", "website", "local-business", "breadcrumb-list"],
  "linking_rules_ref": "services-hub",
  "required_brand_fields": ["display_name", "phone", "primary_city"]
}
