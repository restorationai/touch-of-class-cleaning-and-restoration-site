{
  "name": "ServiceAreaPage",
  "path_pattern": "/service-areas/{area.slug}/",
  "driver": "service_areas[]",
  "title_template": "Plumbing, Heating & Air in {area.city}, {area.state} | {brand.display_name}",
  "h1_template": "Plumbing, Heating and Air in {area.city}",
  "meta_description_template": "Serving {area.city}, {area.state} with 24/7 emergency plumbing plus heating and air conditioning service. Licensed and insured. Call {brand.phone}.",
  "primary_keyword_template": "plumber {area.city|lower}",
  "secondary_keywords": [
    "{area.city|lower} plumbing company",
    "emergency plumber {area.city|lower}",
    "{area.city|lower} hvac company"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 900,
  "image_roles": ["hero", "og", "inline-1"],
  "schema_stubs": ["local-business", "service", "breadcrumb-list"],
  "linking_rules_ref": "service-area",
  "required_brand_fields": ["display_name", "phone"]
}
