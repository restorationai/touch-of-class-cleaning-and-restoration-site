{
  "name": "Home",
  "fixed_ref": "home",
  "path_pattern": "/",
  "title_template": "{brand.display_name} | Plumbing, Heating & Air in {brand.primary_city}, {brand.primary_state}",
  "h1_template": "24/7 Plumbing, Heating and Air in {brand.primary_city}",
  "meta_description_template": "{brand.display_name} provides 24/7 emergency plumbing plus heating and air conditioning service across {brand.primary_city} and surrounding areas. Licensed and insured. Call {brand.phone}.",
  "primary_keyword_template": "plumber {brand.primary_city|lower}",
  "secondary_keywords": [
    "plumber near me",
    "emergency plumber {brand.primary_city|lower}",
    "hvac company {brand.primary_city|lower}"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 1200,
  "image_roles": ["hero", "og", "inline-1", "inline-2", "inline-3"],
  "schema_stubs": ["organization", "website", "local-business", "aggregate-rating"],
  "linking_rules_ref": "home",
  "required_brand_fields": ["display_name", "phone", "primary_city", "primary_state"]
}
