{
  "name": "About",
  "fixed_ref": "about",
  "path_pattern": "/about/",
  "title_template": "About {brand.display_name} | {brand.primary_city} Plumbing & HVAC Company",
  "h1_template": "About {brand.display_name}",
  "meta_description_template": "{brand.display_name} has served {brand.primary_city} since {brand.founded_year}. Meet our licensed plumbing and HVAC team. Licensed, insured, locally owned.",
  "primary_keyword_template": "{brand.display_name|lower} {brand.primary_city|lower}",
  "secondary_keywords": [
    "local plumbing company",
    "licensed plumbing contractor",
    "insured hvac contractor"
  ],
  "search_intent_default": "navigational_trust",
  "target_word_count": 700,
  "image_roles": ["hero", "og", "inline-1"],
  "schema_stubs": ["organization", "website", "local-business", "aggregate-rating", "breadcrumb-list"],
  "linking_rules_ref": "about",
  "required_brand_fields": ["display_name", "founded_year", "primary_city", "certifications"]
}
