{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{post.title}",
  "description": "{post.meta_description}",
  "image": "{post.hero_image_url}",
  "datePublished": "{post.published_at}",
  "dateModified": "{post.updated_at}",
  "author": {
    "@type": "Organization",
    "name": "{brand.display_name}",
    "url": "{brand.canonical_url}"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "{brand.entity_id}",
    "name": "{brand.display_name}",
    "logo": {
      "@type": "ImageObject",
      "url": "{brand.logo_url}"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{post.canonical_url}"
  },
  "articleSection": "{post.primary_service.display_name}",
  "about": "{post.about_entities}"
}
