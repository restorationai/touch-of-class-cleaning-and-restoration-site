{
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": "{brand.entity_id}",
  "name": "{brand.display_name}",
  "url": "{brand.canonical_url}",
  "telephone": "{brand.phone}",
  "email": "{brand.email}",
  "image": "{brand.logo_url}",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{brand.street_address}",
    "addressLocality": "{brand.primary_city}",
    "addressRegion": "{brand.primary_state}",
    "postalCode": "{brand.postal_code}",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "{brand.lat}",
    "longitude": "{brand.lng}"
  },
  "openingHoursSpecification": "{brand.hours_specification}",
  "areaServed": "{brand.area_served}",
  "founder": "{brand.founder}",
  "foundingDate": "{brand.founded_year}",
  "sameAs": "{brand.same_as_urls}",
  "hasCredential": "{brand.certifications}"
}
