{
  "name": "ServiceAreaPage",
  "path_pattern": "/service-areas/{area.slug}/",
  "driver": "service_areas[]",
  "title_template": "Construction Services in {area.city}, {area.state} | {brand.display_name}",
  "h1_template": "Construction Services in {area.city}",
  "meta_description_template": "Serving {area.city}, {area.state} with home remodeling, new construction, roofing, and exterior work. Licensed and insured. Call {brand.phone} for a free estimate.",
  "primary_keyword_template": "construction services {area.city|lower}",
  "secondary_keywords": [
    "{area.city|lower} construction company",
    "general contractor {area.city|lower}",
    "{area.city|lower} remodeling contractor"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 900,
  "image_roles": ["hero", "og", "inline-1"],
  "schema_stubs": ["local-business", "service", "breadcrumb-list"],
  "linking_rules_ref": "service-area",
  "required_brand_fields": ["display_name", "phone"]
}
