{
  "name": "Contact",
  "fixed_ref": "contact",
  "path_pattern": "/contact/",
  "title_template": "Contact {brand.display_name} | Free Estimates in {brand.primary_city}",
  "h1_template": "Contact {brand.display_name}",
  "meta_description_template": "Call {brand.phone} for a free estimate on your construction or remodeling project in {brand.primary_city} and surrounding areas. Licensed and insured.",
  "primary_keyword_template": "{brand.display_name|lower} contact",
  "secondary_keywords": [
    "construction company contact",
    "free construction estimate",
    "general contractor near me"
  ],
  "search_intent_default": "navigational_action",
  "target_word_count": 400,
  "image_roles": ["hero", "og"],
  "schema_stubs": ["organization", "website", "local-business", "breadcrumb-list"],
  "linking_rules_ref": "contact",
  "required_brand_fields": ["display_name", "phone", "email", "hours", "primary_city"]
}
