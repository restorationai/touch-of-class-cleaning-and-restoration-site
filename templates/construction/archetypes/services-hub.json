{
  "name": "ServicesHub",
  "fixed_ref": "services-hub",
  "path_pattern": "/services/",
  "title_template": "Construction Services in {brand.primary_city} | {brand.display_name}",
  "h1_template": "Our Construction Services",
  "meta_description_template": "Full-service general contracting in {brand.primary_city}: remodeling, new construction, roofing, siding, decks, and painting. Free estimates. Call {brand.phone}.",
  "primary_keyword_template": "construction services {brand.primary_city|lower}",
  "secondary_keywords": [
    "general contracting services",
    "home construction services",
    "remodeling services"
  ],
  "search_intent_default": "local_commercial",
  "target_word_count": 800,
  "image_roles": ["hero", "og", "inline-1"],
  "schema_stubs": ["organization", "website", "local-business", "breadcrumb-list"],
  "linking_rules_ref": "services-hub",
  "required_brand_fields": ["display_name", "phone", "primary_city"]
}
