{
  "name": "BlogIndex",
  "fixed_ref": "blog-index",
  "path_pattern": "/blog/",
  "title_template": "Construction Blog | {brand.display_name}",
  "h1_template": "Construction Resources and Insights",
  "meta_description_template": "Guides, checklists, and explainers from {brand.display_name} on remodeling, new construction, roofing, and home improvement projects.",
  "primary_keyword_template": "construction blog {brand.primary_city|lower}",
  "secondary_keywords": [
    "construction guides",
    "home remodeling tips",
    "home improvement insights"
  ],
  "search_intent_default": "informational_browse",
  "target_word_count": 300,
  "image_roles": ["hero", "og"],
  "schema_stubs": ["website", "breadcrumb-list"],
  "linking_rules_ref": "blog-index",
  "required_brand_fields": ["display_name"]
}
