{
  "name": "ServiceAreaServicePage",
  "path_pattern": "/service-areas/{area.slug}/{service.slug}/",
  "driver": "service_areas[] x services[]",
  "enabled_by": "cross_product",
  "title_template": "{service.display_name} in {area.city}, {area.state} | {brand.display_name}",
  "h1_template": "{service.display_name} in {area.city}",
  "meta_description_template": "Trusted {service.display_name|lower} in {area.city}, {area.state}. Licensed general contractor, free estimates, quality craftsmanship. Call {brand.phone}.",
  "primary_keyword_template": "{service.display_name|lower} {area.city|lower}",
  "secondary_keywords_ref": "services[].secondary_keywords + area-suffix",
  "search_intent_default_ref": "services[].primary_intent",
  "target_word_count": 900,
  "image_roles": ["hero", "og", "inline-1", "inline-2"],
  "schema_stubs": ["service", "local-business", "faq", "breadcrumb-list"],
  "linking_rules_ref": "service-area-service",
  "required_brand_fields": ["display_name", "phone", "license_numbers"]
}
