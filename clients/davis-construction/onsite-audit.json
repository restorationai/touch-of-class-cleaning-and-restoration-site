  "environment_caveats": [
    {
      "id": "lighthouse_desktop_only",
      "description": "DataForSEO Lighthouse runs DESKTOP only (formFactor=desktop, cpuSlowdownMultiplier=1, throughputKbps=10240). Mobile performance typically runs 10-20 points lower. Mobile-specific issues are not surfaced by this audit."
    },
    {
      "id": "apex_without_cutover_record",
      "description": "clients/davis-construction.json has no apex_cutover.completed_at, but https://davisconstructioncontractors.com returns 200 and serves the Rank AI Astro build (/_astro/ assets, same templates as staging). Audited the apex, as in the 2026-08-26 run, so month-over-month comparison is like-for-like. No x-robots-tag noindex on the apex, so SEO counts toward the verdict. The client record should get apex_cutover.completed_at backfilled."
    },
    {
      "id": "mcp_generic_api_request",
      "description": "The dataforseo MCP server exposes only a generic api_request, not named on_page_lighthouse / on_page_instant_pages tools. Lighthouse payloads are 0.7-1.0MB each, so this run called /v3/on_page/lighthouse/live/json and /v3/on_page/instant_pages over REST with the DATAFORSEO_* credentials and parsed the responses from disk. Same account and data source. Cost: 6 x $0.005 + 6 x $0.00015 = about $0.031."
    },
    {
      "id": "service_area_slot_substituted",
      "description": "The url-plan marks Madison as the primary service area, but /service-areas/madison-al/ still returns 301 to the homepage (re-checked this run). The service-area slot stays on /service-areas/huntsville-al/, matching the 2026-08-26 run."
    },
    {
      "id": "schema_jsonld_detection",
      "description": "instant_pages does not count JSON-LD in has_micromarkup. JSON-LD was re-verified in the served HTML of every audited page this run: 3-5 blocks each (Organization, WebSite, LocalBusiness, Service, FAQPage, BreadcrumbList), zero parse errors. Missing schema was NOT flagged."
    },
    {
      "id": "render_blocking_dedup",
      "description": "instant_pages has_render_blocking_resources=true on all 6 pages duplicates the Lighthouse render-blocking-insight audit and is not recorded a second time as an on-page issue."
    },
    {
      "id": "onpage_checks_not_flagged",
      "description": "instant_pages no_image_title (image title attributes, not an SEO requirement; alt coverage is 100% on every page) and frame on /service-areas/huntsville-al/ (the intentional Google Maps embed) are not recorded as issues."
    },
    {
      "id": "issue_diff_asymmetry",
      "description": "lighthouse_issues stores the top 5 failing audits per URL. new_issues compares the current stored set against the prior stored set; resolved_issues compares the prior stored set against the CURRENT FULL failing set, so an issue only counts as resolved if it genuinely no longer fails. template_issues is computed from the full failing set."
    }
  ]
