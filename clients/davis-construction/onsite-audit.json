  "environment_caveats": [
    {
      "id": "lighthouse_desktop_only",
      "description": "DataForSEO Lighthouse runs DESKTOP only (formFactor=desktop, cpuSlowdownMultiplier=1, throughputKbps=10240). Mobile performance typically runs 10-20 points lower. Mobile-specific issues are not surfaced by this audit."
    },
    {
      "id": "mcp_generic_api_request",
      "description": "The dataforseo MCP server no longer exposes on_page_lighthouse / on_page_instant_pages as named tools (its surface collapsed to a generic api_request). Lighthouse payloads are 0.7-1.0MB each, so this run called the same endpoints (/v3/on_page/lighthouse/live/json and /v3/on_page/instant_pages) over REST with the DATAFORSEO_* credentials and piped responses to disk. Same account, same data source."
    },
    {
      "id": "service_area_slot_substituted",
      "description": "The url-plan marks Madison as the primary service area, but /service-areas/madison-al/ returns 301 to the homepage. It is absent from sitemap-0.xml and not linked from /service-areas/, so the redirect is a deliberate consolidation of the home city onto the homepage, not a defect. The service-area slot was moved to /service-areas/huntsville-al/ so the archetype gets real coverage. The prior audit measured the homepage twice."
    },
    {
      "id": "render_blocking_dedup",
      "description": "instant_pages sets has_render_blocking_resources=true on all 6 pages. This is the same finding as the Lighthouse render-blocking-insight audit, so it was not recorded a second time as an on-page issue; recording both would inflate the issue counts and produce six spurious new_issues entries."
    },
    {
      "id": "issue_diff_asymmetry",
      "description": "lighthouse_issues stores the top 5 failing audits per URL. To avoid the top-5 cap creating false results, new_issues is computed from the current top-5 against the prior stored set, while resolved_issues is computed against the CURRENT FULL failing set. An issue therefore only counts as resolved if it genuinely no longer fails."
    },
    {
      "id": "new_issue_top5_suppression",
      "description": "Prior lighthouse_issues stored only the top 5 per URL, but prior template_issues recorded audits failing on 5-6 of 6 URLs (cache-insight, image-delivery-insight, largest-contentful-paint, network-dependency-tree-insight, render-blocking-insight, unused-javascript on 6; lcp-discovery-insight on 5). Those IDs are treated as present on every prior URL so they are not reported as new_issues just because they fell outside a prior top-5. Failing threshold matches the prior run: insight/diagnostic audits score < 0.9, weighted performance metric audits score < 1. For resolved_issues, any numeric audit still scoring < 1 counts as still flagged."
    },
    {
      "id": "live_origin_selection",
      "description": "The client record has no apex_cutover.completed_at field, but cut_over_at is 2026-05-28T18:48:09Z and deploy_url is the apex, so the apex origin was audited (same as the prior three audits). No x-robots-tag noindex header is served on the apex, so SEO counts toward the verdict."
    },
    {
      "id": "schema_jsonld_detection",
      "description": "instant_pages reports has_micromarkup=false on all 6 pages, but the served HTML carries 3-5 JSON-LD blocks per page (Organization, WebSite, LocalBusiness, Service, FAQPage, BreadcrumbList) with zero parse errors. has_micromarkup does not count JSON-LD, so missing-schema was NOT flagged."
    },
    {
      "id": "micromarkup_errors_triage",
      "description": "instant_pages sets has_micromarkup_errors=true on the 5 pages that carry FAQPage. A one-page /v3/on_page/microdata validation of /services/roofing/ (cost $0.00015) shows the only error-level result is \"missing field 'answerCount'\" on every Question node, plus a \"missing field 'text'\" warning. Google's FAQPage rich-result spec requires only Question.name and acceptedAnswer.text, so this is a schema.org-strictness finding, not a rich-result blocker. It was recorded as has_micromarkup_errors at LOW severity instead of the rubric's medium so it does not create a false amber. The fix is still cheap (add answerCount: 1 to each Question in the FAQ schema component)."
    }
  ]
}
