  "environment_caveats": [
    {
      "id": "lighthouse_desktop_only",
      "description": "DataForSEO Lighthouse runs DESKTOP only (formFactor=desktop, cpuSlowdownMultiplier=1, throughputKbps=10240). Mobile performance typically runs 10-20 points lower. Mobile-specific issues are not surfaced by this audit."
    },
    {
      "id": "mcp_generic_api_request",
      "description": "The dataforseo MCP server no longer exposes on_page_lighthouse / on_page_instant_pages as named tools (its surface collapsed to a generic api_request). Lighthouse payloads are 0.7-1.0MB each, so this run called the same endpoints (/v3/on_page/lighthouse/live/json and /v3/on_page/instant_pages) over REST with the DATAFORSEO_* credentials and piped responses to disk. Same account, same data source."
    },
    {
      "id": "service_area_slot_substituted",
      "description": "The url-plan marks Madison as the primary service area, but /service-areas/madison-al/ returns 301 to the homepage. It is absent from sitemap-0.xml and not linked from /service-areas/, so the redirect is a deliberate consolidation of the home city onto the homepage, not a defect. The service-area slot was moved to /service-areas/huntsville-al/ so the archetype gets real coverage. The prior audit measured the homepage twice."
    },
    {
      "id": "schema_jsonld_detection",
      "description": "instant_pages reports has_micromarkup=false on all 6 pages, but JSON-LD was re-verified in the served HTML of every page this run: 3-5 valid blocks each (LocalBusiness, Organization, WebSite, Service, FAQPage, BreadcrumbList), zero parse errors. has_micromarkup does not count JSON-LD, so missing-schema was NOT flagged."
    },
    {
      "id": "render_blocking_dedup",
      "description": "instant_pages sets has_render_blocking_resources=true on all 6 pages. This is the same finding as the Lighthouse render-blocking-insight audit, so it was not recorded a second time as an on-page issue; recording both would inflate the issue counts and produce six spurious new_issues entries."
    },
    {
      "id": "issue_diff_asymmetry",
      "description": "lighthouse_issues stores the top 5 failing audits per URL. To avoid the top-5 cap creating false results, new_issues is computed from the current top-5 against the prior stored set, while resolved_issues is computed against the CURRENT FULL failing set. An issue therefore only counts as resolved if it genuinely no longer fails."
    }
  ]
