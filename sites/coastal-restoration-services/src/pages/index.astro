---
import { getEntry, getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CtaBanner from "~/components/CtaBanner.astro";
import FAQSection from "~/components/FAQSection.astro";
import InternalLinks from "~/components/InternalLinks.astro";
import Hero from "~/components/ui/Hero.astro";
import VideoEmbed from "~/components/VideoEmbed.astro";
import TrustStrip from "~/components/ui/TrustStrip.astro";
import ReviewsStrip from "~/components/ui/ReviewsStrip.astro";
import AboutSection from "~/components/ui/AboutSection.astro";
import ServicesStrip from "~/components/ui/ServicesStrip.astro";
import ProcessSection from "~/components/ui/ProcessSection.astro";
import InsuranceStrip from "~/components/ui/InsuranceStrip.astro";
import BeforeAfterSection from "~/components/ui/BeforeAfterSection.astro";
import RecentWork from "~/components/RecentWork.astro";
import ProudlyServing from "~/components/ui/ProudlyServing.astro";
import ReviewsSection from "~/components/ui/ReviewsSection.astro";
import { brand } from "~/lib/brand";
import { workPairs } from "~/data/work";

const entry = await getEntry("pages", "home");
if (!entry) throw new Error("Missing content: pages/home.md — has Skill 3 rendered yet?");
const { Content } = await entry.render();
const data = entry.data;

const heroImage = data.hero || "/images/hero-bg.webp";

// Pull top 6 services by priority for the home page strip
const allServices = await getCollection("services");
const services = (allServices as CollectionEntry<"services">[])
  .sort((a, b) => (b.data.priority || 0) - (a.data.priority || 0))
  .slice(0, 6);
---

<BaseLayout
  title={data.title}
  meta_description={data.meta_description}
  hero_image_url={heroImage}
  schema_stubs={["organization", "website", "local-business"]}
  schema_ctx={{ archetype: "home" }}
  faq={data.faq}
>
  {/* Homepage hero background. DEFAULT for new builds: a branded small-fleet
      scene (3-5 matched vehicles in the client's brand-color livery, region-
      matched street, golden hour, calm left third for the headline) generated
      per the client's image-style-guide.md "Homepage hero" spec, uploaded to
      R2 at brand/hero-fleet.webp and referenced via brand.imagesBase — or
      dropped into public/images/hero-bg.webp if R2 isn't provisioned yet. */}
  <Hero title={data.h1} subtitle={data.meta_description} backgroundImage="/images/hero-bg.webp" />

  <TrustStrip />

  <ReviewsStrip />

  <AboutSection imageSrc="/images/team.webp" imageAlt={`${brand.displayName} technician loading a branded service van`}>
    <p>
      {brand.displayName} serves {brand.primaryCity} and the surrounding {brand.primaryState} area with full-service damage restoration. From emergency water extraction, structural drying, and mold remediation to fire and smoke cleanup, sewage removal, and crawl space encapsulation, our technicians handle it all — and we answer the phone 24/7, so help is on the way the moment something goes wrong.
    </p>
  </AboutSection>

  {services.length > 0 && <ServicesStrip services={services} />}

  <ProcessSection />

  <InsuranceStrip />

  <BeforeAfterSection pairs={workPairs} />

  <RecentWork />

  <!-- Dependable Service section — mirrored from their existing site at
       Santino's request (2026-07-30), with their real office/crew photo and
       their real client testimonial videos beneath it. -->
  <section class="bg-dark-50 py-20 border-t border-dark/10">
    <div class="container-wide max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-10 items-center mb-16">
        <div>
          <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-dark mb-4">Dependable Service When It Matters Most</h2>
          <p class="text-lg text-dark/70 leading-relaxed">
            {brand.displayName} has built its reputation on being there when property owners
            need help the most. We serve Santa Maria and surrounding areas with the same level
            of commitment whether it's a weekend flood, a late-night fire, or an urgent mold
            discovery.
          </p>
        </div>
        <img src="/images/dependable-service.webp" alt="The Coastal Restoration Services team" width="975" height="650"
          class="rounded-2xl shadow-lg w-full object-cover" loading="lazy" />
      </div>
      <h3 class="text-2xl font-black uppercase tracking-tighter text-dark mb-6 text-center">Hear It From Our Customers</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <VideoEmbed videoId="7Hmy0a7qki4" title="David Prochaska Testimonial | Coastal Restoration Services" />
        <VideoEmbed videoId="F2xmHkI1J2w" title="Bernie Baggarly Testimonial | Coastal Restoration Services" />
        <VideoEmbed videoId="sfwYc4FkHsU" title="Stephanie Vega Testimonial | Coastal Restoration Services" />
      </div>
      <p class="text-center mt-8">
        <a href="/case-studies/" class="inline-flex items-center justify-center rounded-xl px-8 py-3 font-black uppercase tracking-wide bg-primary-600 text-white hover:bg-primary-700 transition-colors">See All Customer Stories</a>
      </p>
    </div>
  </section>

  <ReviewsSection />

  <ProudlyServing />

  <CtaBanner heading="24/7 Emergency Response" subheading="We answer the phone day and night. Insurance billing accepted." />

  <FAQSection faq={data.faq} />

  <section class="bg-white py-20 border-t border-dark/10">
    <div class="container-wide max-w-6xl mx-auto prose prose-xl prose-invert prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tighter prose-a:text-primary-700 text-dark/70">
      <Content />
    </div>
  </section>

  <InternalLinks paths={data.internal_links} heading="Where to Next" />
</BaseLayout>
