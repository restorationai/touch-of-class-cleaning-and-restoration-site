---
// Lite YouTube embed — thumbnail + play button; the iframe only loads on
// click (page-weight discipline: no YouTube JS on initial load).
interface Props {
  videoId: string;
  title: string;
}
const { videoId, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---
<div class="lite-yt relative w-full aspect-video rounded-2xl overflow-hidden bg-dark-900 shadow-lg cursor-pointer group"
     data-video-id={videoId} role="button" tabindex="0" aria-label={`Play video: ${title}`}>
  <img src={thumb} alt={title} loading="lazy"
       class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
  <div class="absolute inset-0 bg-black/25 group-hover:bg-black/10 transition-colors"></div>
  <div class="absolute inset-0 flex items-center justify-center">
    <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-primary-600 flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
      <svg viewBox="0 0 24 24" fill="white" class="w-7 h-7 md:w-9 md:h-9 ml-1"><path d="M8 5v14l11-7z"/></svg>
    </span>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>(".lite-yt").forEach((el) => {
    const load = () => {
      const id = el.dataset.videoId;
      if (!id || el.querySelector("iframe")) return;
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = el.getAttribute("aria-label") || "Video";
      f.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      f.allowFullscreen = true;
      f.className = "absolute inset-0 w-full h-full";
      el.appendChild(f);
    };
    el.addEventListener("click", load);
    el.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") load(); });
  });
</script>
