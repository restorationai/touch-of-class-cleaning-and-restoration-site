---
// Embeddable estimate form (C10, 2026-09-16): a chrome-free page BDA (or
// anyone) can iframe into ad landing pages. Same form, same /api/estimate
// pipeline, same anti-spam. Source attribution comes from the ?source=
// query param (e.g. /embed/estimate?source=google_ads), which the form
// script treats as authoritative inside an embed. Snippet:
//   <iframe src="https://DOMAIN/embed/estimate?source=google_ads"
//     style="width:100%;max-width:680px;height:760px;border:0"
//     loading="lazy" title="Free estimate"></iframe>
import "~/styles/global.css";
import FreeEstimateForm from "~/components/FreeEstimateForm.astro";
import { brand } from "~/lib/brand";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Free Estimate | {brand.displayName}</title>
  </head>
  <body class="bg-transparent">
    <FreeEstimateForm compact heading="Request Your Free Estimate" />
  </body>
</html>
