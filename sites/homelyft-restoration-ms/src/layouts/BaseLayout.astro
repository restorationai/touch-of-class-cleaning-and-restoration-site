---
import "~/styles/global.css";
import { brand } from "~/lib/brand";
import Analytics from "~/components/Analytics.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Schema from "~/components/Schema.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import { Phone } from "@lucide/astro";
import type { PageSchemaContext } from "~/lib/schema";

type Props = {
  title: string;
  meta_description: string;
  canonical_url?: string;
  hero_image_url?: string;
  schema_stubs?: string[];
  schema_ctx?: Partial<PageSchemaContext>;
  breadcrumb?: { name: string; url?: string }[];
  faq?: { question: string; answer: string }[];
  noindex?: boolean;
};

const {
  title,
  meta_description,
  canonical_url,
  hero_image_url,
  schema_stubs = [],
  schema_ctx = {},
  breadcrumb,
  faq,
  noindex = false,
} = Astro.props;

const fullCanonical = canonical_url ?? `${brand.canonicalUrl}${Astro.url.pathname}`;
const rawOgImage = hero_image_url ?? `${brand.imagesBase}/brand/hero.webp`;
// og:image/twitter:image must be ABSOLUTE (audit: og_image_relative_url) —
// social scrapers don't resolve site-relative paths, so shares showed no image.
const ogImage = rawOgImage.startsWith("http")
  ? rawOgImage
  : new URL(rawOgImage, brand.canonicalUrl).href;

// Keep the rendered <title> at or under 65 chars (audit: title_length_over_65 on
// every page). Plan-generated titles are "{descriptor} | {brand}" compositions;
// shorten them here rather than editing hundreds of content files.
function fitTitle(raw: string): string {
  const MAX = 65;
  let t = raw.trim();
  if (t.length <= MAX) return t;
  // 1) Swap the full display name for the short name when they differ.
  if (brand.shortName && brand.shortName !== brand.displayName && t.includes(brand.displayName)) {
    t = t.split(brand.displayName).join(brand.shortName);
    if (t.length <= MAX) return t;
  }
  // 2) Drop a " | "-delimited segment that is exactly the brand name — the
  //    remaining segment keeps the page's keyword phrasing.
  let parts = t.split(" | ").map((p) => p.trim());
  if (parts.length > 1) {
    const brandNames = [brand.displayName, brand.shortName, brand.legalName].filter(Boolean);
    const kept = parts.filter((p) => !brandNames.includes(p));
    if (kept.length > 0 && kept.length < parts.length) {
      parts = kept;
      t = parts.join(" | ");
      if (t.length <= MAX) return t;
    }
  }
  // 3) Drop trailing segments until it fits.
  while (t.length > MAX && parts.length > 1) {
    parts = parts.slice(0, -1);
    t = parts.join(" | ");
  }
  if (t.length <= MAX) return t;
  // 4) Last resort: truncate on a word boundary.
  const cut = t.slice(0, MAX + 1);
  const space = cut.lastIndexOf(" ");
  return (space > 40 ? cut.slice(0, space) : t.slice(0, MAX)).trim();
}
const pageTitle = fitTitle(title);

// Google Fonts stylesheet URL — loaded non-render-blocking below (audit:
// render_blocking_resources; was a blocking @import in global.css).
const fontsHref = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap";

// Only claim "Licensed & Insured" in the announcement bar when we actually
// hold license data for this client (hardcoded-claims audit).
const isLicensed = Array.isArray(brand.licenseNumbers) && brand.licenseNumbers.length > 0;

const ctx: PageSchemaContext = {
  archetype: schema_ctx.archetype ?? "unknown",
  url: Astro.url.pathname,
  title,
  meta_description,
  hero_image_url: ogImage,
  breadcrumb,
  faq,
  ...schema_ctx,
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={meta_description} />
    <link rel="canonical" href={fullCanonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={meta_description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={brand.displayName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={meta_description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Favicon set — generated from the client's real logo mark (see clients/{slug}/). */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="alternate icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Web fonts, loaded without blocking first paint: preconnect + print-media
        swap trick. The blocking @import was removed from global.css. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>

    <Schema stubs={schema_stubs} ctx={ctx} />

    {/* Restoration AI Chat Widget — per-client: only renders if brand.emergencyWidgetId
        is set (the client's own company_id). Never hardcode a company_id here. */}
    {(brand as any).emergencyWidgetId && (
      <>
        <script is:inline set:html={`window.EmergencyWidgetId = ${JSON.stringify((brand as any).emergencyWidgetId)};`} />
        <script is:inline src="https://app.restorationai.io/widget-main.js" async></script>
      </>
    )}
      <Analytics />

    {/* Keep the Restoration AI chat FAB (#rai-widget-wrapper, max z-index) clear of
        the mobile sticky call bar — it otherwise overlaps the bar's right side. */}
    <style is:global>
      @media (max-width: 767px) {
        #rai-widget-wrapper {
          bottom: 76px !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="hidden md:block bg-primary-600 text-white text-xs md:text-sm font-bold text-center py-2 px-4 tracking-wider">
      {isLicensed
        ? <>Licensed &amp; Insured &mdash; {brand.primaryCity}, {brand.primaryState} {brand.specialistPhrase}</>
        : <>{brand.primaryCity}, {brand.primaryState} {brand.specialistPhrase} &mdash; {brand.announcementSuffix}</>}
    </div>
    <Header />
    <Breadcrumb trail={breadcrumb} />
    <main class="flex-1 pb-14 md:pb-0">
      <slot />
    </main>
    <Footer />
    <a href={`tel:${brand.phoneRaw}`} class="fixed bottom-0 inset-x-0 z-40 md:hidden flex items-center justify-center gap-3 bg-primary-600 text-white font-black py-4 text-base shadow-[0_-4px_24px_rgba(220,38,38,0.35)] border-t border-primary-700">
      <Phone size={18} strokeWidth={3} />
      Call Now: {brand.phone}
    </a>
    {brand.trackingPhone && brand.trackingPhoneRaw && (
      /* Dynamic Number Insertion (2026-08-24; source attribution 2026-09-10):
         humans see + dial a tracking number; the HTML source, JSON-LD schema,
         and cached/crawled copies keep the canonical NAP number, so citations
         stay consistent. Phase 1 swaps to the default tracking number
         immediately. Phase 2 classifies the visitor (click IDs, then
         utm_source, then referrer; last non-direct touch persisted 30 days)
         and, when the client has a number for that channel (KV-backed map at
         restorationai.io/dni/{slug}.json), upgrades the displayed number so
         the call attributes to its source. Skips script/style nodes so the
         structured data is never rewritten. */
      <script is:inline define:vars={{
        tp: brand.trackingPhone, tpr: brand.trackingPhoneRaw,
        op: brand.phone, opr: brand.phoneRaw, slug: brand.slug,
      }}>
        (function () {
          function swap(fromFmt, fromRaw, toFmt, toRaw) {
            document.querySelectorAll('a[href^="tel:"]').forEach(function (a) {
              var href = a.getAttribute("href") || "";
              if (href.indexOf(fromRaw) !== -1 || href === "tel:" + fromFmt) {
                a.setAttribute("href", "tel:" + toRaw);
              }
            });
            var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
            var hits = [];
            while (walker.nextNode()) {
              var n = walker.currentNode;
              var tag = n.parentElement && n.parentElement.tagName;
              if (tag === "SCRIPT" || tag === "STYLE") continue;
              if (n.nodeValue && n.nodeValue.indexOf(fromFmt) !== -1) hits.push(n);
            }
            hits.forEach(function (n) {
              n.nodeValue = n.nodeValue.split(fromFmt).join(toFmt);
            });
          }
          function detectSource() {
            var q = new URLSearchParams(location.search);
            if (q.get("gclid") || q.get("gbraid") || q.get("wbraid")) return "google_ads";
            if (q.get("msclkid")) return "bing";
            if (q.get("fbclid")) return "facebook";
            var us = (q.get("utm_source") || "").toLowerCase();
            var um = (q.get("utm_medium") || "").toLowerCase();
            if (us) {
              if (us.indexOf("yelp") !== -1) return "yelp";
              if (us.indexOf("chatgpt") !== -1 || us.indexOf("openai") !== -1) return "chatgpt";
              if (us.indexOf("gemini") !== -1) return "gemini";
              if (us.indexOf("instagram") !== -1 || us === "ig") return "instagram";
              if (us.indexOf("facebook") !== -1 || us === "fb" || us === "meta") return "facebook";
              if (us.indexOf("bing") !== -1) return "bing";
              if (us.indexOf("google") !== -1 && (um.indexOf("cpc") !== -1 || um.indexOf("paid") !== -1 || um.indexOf("ppc") !== -1)) return "google_ads";
            }
            var ref = document.referrer || "";
            var host = "";
            try { host = new URL(ref).hostname.toLowerCase(); } catch (e) {}
            if (!host || host === location.hostname) return null;
            if (host.indexOf("yelp.") !== -1) return "yelp";
            if (host.indexOf("chatgpt.com") !== -1 || host.indexOf("chat.openai.com") !== -1) return "chatgpt";
            if (host.indexOf("gemini.google") !== -1 || host.indexOf("bard.google") !== -1) return "gemini";
            if (host.indexOf("instagram.com") !== -1) return "instagram";
            if (host.indexOf("facebook.com") !== -1 || host.indexOf("fb.com") !== -1 || host.indexOf("messenger.com") !== -1) return "facebook";
            if (host.indexOf("bing.com") !== -1) return "bing";
            return null;
          }
          function attributedSource() {
            var KEY = "rankai_src", DAYS30 = 30 * 864e5, saved = null;
            try { saved = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) {}
            if (saved && (!saved.t || Date.now() - saved.t > DAYS30)) saved = null;
            var fresh = detectSource();
            // Last non-direct touch: a new channel overwrites, direct keeps.
            if (fresh) {
              saved = { s: fresh, t: Date.now() };
              try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {}
            }
            try { window.rankaiSource = (saved && saved.s) || "default"; } catch (e) {}
            return saved && saved.s;
          }
          function run() {
            swap(op, opr, tp, tpr);
            var src = attributedSource();
            if (!src || !slug) return;
            fetch("https://restorationai.io/dni/" + slug + ".json")
              .then(function (r) { return r.json(); })
              .then(function (map) {
                var e = map && map.sources && map.sources[src];
                if (e && e.raw && e.fmt) swap(tp, tpr, e.fmt, e.raw);
              })
              .catch(function () {});
          }
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", run);
          } else run();
        })();
      </script>
    )}
  </body>
</html>