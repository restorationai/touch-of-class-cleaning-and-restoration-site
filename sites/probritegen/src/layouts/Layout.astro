---
import '../styles/global.css';
import Header from '../components/Header';
import Footer from '../components/Footer';
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="ProBrite Gen Water Damage & Solutions" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col overflow-x-hidden">
    <Header client:load />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer client:load />
    
    <!-- Restoration AI Chat Widget -->
    <script is:inline>
      window.EmergencyWidgetId = "CO-1775316517177";
    </script>
    <script is:inline src="https://app.restorationai.io/widget-main.js" async></script>
    <!-- End Restoration AI Chat Widget -->
  </body>
</html>
