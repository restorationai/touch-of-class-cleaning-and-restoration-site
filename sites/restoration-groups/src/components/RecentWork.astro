---
// "Recent Work" gallery — real job photos uploaded by the crew via the intake link
// (branding/{cid}/job-photos), pulled in at build time. Renders nothing if there
// are no photos yet, so it never shows an empty section.
import { brand } from "~/lib/brand";
import { srcsetFor } from "~/lib/images";

const photos = (brand.jobPhotos || []).slice(0, 12);

// Per-photo alt text for the real client photos (sourced from the client's
// existing sites; falls back to the generic alt for any un-mapped photo).
const ALTS: Record<string, string> = {
  "/images/work/job-1.webp":
    "Air movers and drying equipment staged in front of a The Restoration Group van at a New Jersey job site",
  "/images/work/job-2.webp":
    "The Restoration Group technicians in protective suits unloading drying equipment from the company van",
  "/images/work/job-3.webp":
    "Technician in a The Restoration Group shirt carrying two air movers up the front steps of a home",
  "/images/work/job-4.webp":
    "Restoration technician in a respirator hand-cleaning a water-damaged hardwood subfloor",
  "/images/work/job-5.webp":
    "Air movers positioned to dry a finished basement after water damage",
  "/images/work/job-6.webp":
    "Technician removing water-damaged plank flooring during a basement flood cleanup",
};
---

{photos.length >= 3 && (
  <section class="section bg-dark-50 border-t border-dark/10">
    <div class="container-wide">
      <div class="mb-8">
        <div class="eyebrow">Recent Work</div>
        <h2>Real jobs from our {brand.primaryCity} crews</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {photos.map((src) => {
          const img = srcsetFor(src);
          return (
            <div class="relative aspect-square rounded-xl overflow-hidden border border-dark/10 shadow-lg bg-white">
              <img
                src={src}
                srcset={img.srcset}
                sizes={img.srcset ? "(min-width:1024px) 25vw, (min-width:640px) 33vw, 50vw" : undefined}
                width={img.width}
                height={img.height}
                alt={ALTS[src] ?? `${brand.displayName} — recent ${brand.primaryCity} restoration job`}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
