---
import { getEntry, getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CtaBanner from "~/components/CtaBanner.astro";
import FAQSection from "~/components/FAQSection.astro";
import Hero from "~/components/ui/Hero.astro";
import FreeEstimateForm from "~/components/FreeEstimateForm.astro";
import TrustStrip from "~/components/ui/TrustStrip.astro";
import InsuranceBanner from "~/components/ui/InsuranceBanner.astro";
import ReviewsStrip from "~/components/ui/ReviewsStrip.astro";
import AboutSection from "~/components/ui/AboutSection.astro";
import ServicesStrip from "~/components/ui/ServicesStrip.astro";
import ProcessSection from "~/components/ui/ProcessSection.astro";
import GallerySection from "~/components/ui/GallerySection.astro";
import BeforeAfterSection from "~/components/ui/BeforeAfterSection.astro";
import RecentWork from "~/components/RecentWork.astro";
import ProudlyServing from "~/components/ui/ProudlyServing.astro";
import ReviewsSection from "~/components/ui/ReviewsSection.astro";
import { brand } from "~/lib/brand";
import { workPairs } from "~/data/work";
import homepageServices from "~/data/homepage-services.json";

const entry = await getEntry("pages", "home");
if (!entry) throw new Error("Missing content: pages/home.md — has Skill 3 rendered yet?");
const { Content } = await entry.render();
const data = entry.data;

const heroImage = data.hero || `${brand.imagesBase}/brand/hero.webp`;

// Homepage services = the client's curated core (as NaRestCo requested),
// pinned in plan-input "homepage_services" and mirrored to
// src/data/homepage-services.json (site_structure.py). Parity pages never
// land here.
const targetSlugs = (homepageServices as string[]).length
  ? (homepageServices as string[])
  : ["water-damage-restoration", "fire-damage-restoration", "mold-remediation",
     "biohazard-cleanup", "storm-damage-restoration", "general-contracting"];
const allServices = await getCollection("services");
const services = targetSlugs
  .map(slug => allServices.find(s => s.data.service_slug === slug || s.id.includes(slug)))
  .filter(s => s !== undefined) as CollectionEntry<"services">[];
---

<BaseLayout
  title={data.title}
  meta_description={data.meta_description}
  hero_image_url={heroImage}
  schema_stubs={["organization", "website", "local-business"]}
  schema_ctx={{ archetype: "home" }}
  faq={data.faq}
>
  {/* Homepage hero background. DEFAULT for new builds: a branded small-fleet
      scene (3-5 matched vehicles in the client's brand-color livery, region-
      matched street, golden hour, calm left third for the headline) generated
      per the client's image-style-guide.md "Homepage hero" spec, uploaded to
      R2 at brand/hero-fleet.webp and referenced via brand.imagesBase — or
      dropped into public/images/hero-bg.webp if R2 isn't provisioned yet. */}
  <Hero title={data.h1} subtitle={data.meta_description} backgroundImage="/images/hero-bg.webp">
    {/* Restoration is call-first (Santino 2026-09-11): an emergency lead
        should dial, not fill a form — the Get a Free Estimate button still
        covers the form path lower on the page. Other verticals keep it. */}
    {brand.vertical !== "restoration" ? (
      <FreeEstimateForm slot="form" variant="hero" />
    ) : null}
  </Hero>

  <TrustStrip />
  <InsuranceBanner />

  <ReviewsStrip />

  <AboutSection imageSrc="/images/team.webp" imageAlt={`${brand.displayName} Team`}>
    <p>
      {/* Vertical copy — never hardcode a trade phrase here (industry-bleed
          audit 2026-07-31: the light variant of this paragraph shipped All
          Pro's plumbing identity on four restoration sites). */}
      {brand.homeAboutBlurb}
    </p>
  </AboutSection>

  {services.length > 0 && <ServicesStrip services={services} />}

  <ProcessSection />

  {/* "Our Work" = the before/after sliders (restored 2026-09-30; the 09-29
      pre-sweep restore had dropped them). Case studies live on /case-studies/. */}
  <BeforeAfterSection pairs={workPairs} />

  {/* NaRestCo's own job-photo gallery (pre-sweep homepage); RecentWork kept. */}
  <GallerySection />

  <RecentWork />

  <ReviewsSection />

  <ProudlyServing />

  <CtaBanner heading="24/7 Emergency Response" subheading="We answer the phone day and night. Insurance billing accepted." />

  <FAQSection faq={data.faq} />

  <section class="bg-dark py-20 border-t border-white/10">
    <div class="container-wide max-w-6xl mx-auto prose prose-xl prose-invert prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tighter prose-a:text-primary-500 text-white/70">
      <Content />
    </div>
  </section>
</BaseLayout>
