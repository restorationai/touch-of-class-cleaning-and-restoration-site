---
import { brand } from "~/lib/brand";
const is247 = /24\s*[\/x-]?\s*7|24 ?hours/i.test(String(brand.hours || ""));
---

<header class="bg-dark text-white sticky top-0 z-50 border-b border-white/10 shadow-md">
  <div class="container-wide flex items-center justify-between gap-6 h-20">
    <a href="/" class="flex items-center gap-3 no-underline text-white group flex-shrink-0">
      {brand.logoUrl && (
        <img src={brand.logoUrl} alt={`${brand.displayName} logo`} class="h-10 w-auto group-hover:scale-105 transition-transform drop-shadow-[0_0_8px_rgba(255,255,255,0.8)]" width="4468" height="960" loading="eager" />
      )}
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-[11px] font-black uppercase tracking-widest h-full">
      <a href="/emergency/" class="text-primary-400 hover:text-primary-300 no-underline transition-colors py-8">Emergency</a>
      <a href="/services/" class="hover:text-primary-400 no-underline transition-colors py-8">Services</a>
      <a href="/service-areas/" class="hover:text-primary-400 no-underline transition-colors py-8">Areas</a>
      <a href="/about/" class="hover:text-primary-400 no-underline transition-colors py-8">About</a>
      <a href="/blog/" class="hover:text-primary-400 no-underline transition-colors py-8">Blog</a>
      <a href="/contact/" class="hover:text-primary-400 no-underline transition-colors py-8">Contact</a>
    </nav>

    <a href={`tel:${brand.phoneRaw}`} class="btn-primary text-xs px-4 py-2 shadow-primary-900/40 text-center leading-tight">
      <span class="hidden sm:block tracking-wider whitespace-nowrap">{is247 ? `24/7 EMERGENCY: ${brand.phone}` : `CALL TODAY: ${brand.phone}`}</span>
      <span class="sm:hidden flex flex-col items-center gap-0.5">
        <span class="text-[9px] font-bold tracking-[0.15em] opacity-80 uppercase">Call Now</span>
        <span class="font-black tracking-wide">{brand.phone}</span>
      </span>
    </a>
  </div>
</header>
