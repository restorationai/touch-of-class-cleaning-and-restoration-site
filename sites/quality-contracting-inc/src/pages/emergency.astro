---
// /emergency/ — INDEXABLE emergency-intent page. Built for verbatim quotability
// by AI assistants (ChatGPT, Perplexity, etc.): short standalone answer
// sentences, question-phrased H2s with an answer capsule as the first
// paragraph, and FAQPage + Service + LocalBusiness JSON-LD via the existing
// Schema mechanism.
//
// CLAIMS HONESTY: the response-time wording must match what the client already
// claims elsewhere (lp-manifest bodyContent / brand.ts). This canonical starter
// makes NO minutes-based promise — if a client publishes one (e.g. narestco's
// 60-minute claim), update `responseClaim` + the speed FAQ in that site's copy.
// 24/7 language is gated on brand.hours exactly like the Header.
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CtaBanner from "~/components/CtaBanner.astro";
import FAQSection from "~/components/FAQSection.astro";
import Hero from "~/components/ui/Hero.astro";
import TrustStrip from "~/components/ui/TrustStrip.astro";
import { brand } from "~/lib/brand";
import { Phone, MapPin } from "@lucide/astro";

const is247 = /24\s*[\/x-]?\s*7|24 ?hours/i.test(String(brand.hours || ""));
const shortLabel = brand.shortName || brand.displayName;

// No invented minutes — this client has no published response-time number.
const responseClaim = is247
  ? "60-minute emergency response, day or night"
  : "rapid emergency response during business hours";

const areas = (await getCollection("serviceAreas")).sort(
  (a, b) =>
    Number(b.data.primary) - Number(a.data.primary) ||
    (b.data.priority || 0) - (a.data.priority || 0)
);
const cityPreview = areas.slice(0, 5).map((a) => a.data.city).join(", ");

const h1 = is247
  ? `24/7 Emergency Water Damage Response in ${brand.primaryCity}`
  : `Emergency Water Damage Response in ${brand.primaryCity}`;

const metaDescription = `Flooded home or burst pipe in ${brand.primaryCity}, ${brand.primaryState}? ${shortLabel} is typically on-site within 60 minutes${is247 ? ", 24/7" : " during business hours"}, with direct insurance billing. Call ${brand.phone}.`;

// Opening answer capsule — 2-3 standalone sentences an AI engine can quote verbatim.
// Fran's email 2026-08-19: emergencies are NOT water-only — the company
// handles water, fire, board-up, temporary fencing, tarping, and structural
// surety in emergencies (client-attested list, quoted from his own email).
const answerCapsule = `${brand.displayName} provides ${is247 ? "24/7 " : ""}emergency response in ${brand.primaryCity}, ${brand.primaryState} and nearby cities including ${cityPreview}: water damage, fire damage, emergency board-up, temporary fencing, roof tarping, and structural surety. We provide ${responseClaim}, and we bill your insurance company directly. Call ${brand.phone} to get a crew moving now.`;

const faq = [
  is247
    ? {
        question: `Is ${shortLabel} really available 24/7?`,
        answer: `Yes. ${brand.displayName} answers emergency calls 24 hours a day, 7 days a week, including weekends and holidays. Call ${brand.phone} any time and a live person will dispatch a crew.`,
      }
    : {
        question: `When can I reach ${shortLabel}?`,
        answer: `${brand.displayName} answers during business hours (${brand.hours}). Call ${brand.phone} and we will dispatch a crew as quickly as possible.`,
      },
  {
    question: "How quickly can you be on-site?",
    answer: `Crews are typically on-site within 60 minutes of your call anywhere in the ${brand.primaryCity} area${is247 ? ", 24/7" : ""}. Call ${brand.phone} and we will give you a real ETA for your address.`,
  },
  {
    question: "Do you bill my insurance company directly?",
    answer: `Yes. We work with all major insurance carriers and bill them directly, and we document the loss with photos and moisture readings so your adjuster has everything needed to process the claim.`,
  },
  {
    question: "Should I start removing the water myself?",
    answer: `Only if it is a small amount of clean water and you can stay away from electrical outlets and appliances. Never step into standing water in a room with live electricity, and never handle sewage or floodwater yourself — it can carry bacteria and contaminants. Shut off the water source if you can, then call ${brand.phone}.`,
  },
  {
    question: "How long does drying take?",
    answer: `Most water-damaged homes dry in about three to five days with professional extraction, air movers, and dehumidifiers. We take moisture readings daily and only remove equipment once materials test dry, which prevents mold from developing later.`,
  },
];
---

<BaseLayout
  title={`${h1} | ${shortLabel}`}
  meta_description={metaDescription}
  schema_stubs={["local-business", "service", "faq", "breadcrumb-list"]}
  schema_ctx={{
    archetype: "emergency-landing",
    service_display: "Emergency Water Damage Restoration",
  }}
  breadcrumb={[{ name: "Home", url: "/" }, { name: "Emergency" }]}
  faq={faq}
>
  <Hero title={h1} subtitle={metaDescription} backgroundImage="/images/hero-bg.webp" />

  <!-- ANSWER CAPSULE -->
  <section class="section-tight bg-dark">
    <div class="container-wide">
      <div class="max-w-content mx-auto text-center">
        <p class="text-xl md:text-2xl text-white/90 leading-relaxed font-medium mb-8">{answerCapsule}</p>
        <a href={`tel:${brand.phoneRaw}`} class="btn-accent text-base">
          <Phone size={18} /> Call {brand.phone} Now
        </a>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- WHAT SHOULD I DO RIGHT NOW -->
  <section class="section-tight bg-dark">
    <div class="container-wide">
      <h2 class="text-2xl md:text-3xl font-black mb-6">Emergencies we handle</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {[
          ["Water damage", "Extraction, drying, and moisture documentation"],
          ["Fire damage", "Securing, cleanup, and reconstruction"],
          ["Emergency board-up", "Windows, doors, and storefronts secured fast"],
          ["Temporary fencing", "Site security while the property is open"],
          ["Roof tarping", "Stop active leaks before more damage spreads"],
          ["Structural surety", "Shoring and stabilization you can stand behind"],
        ].map(([t, d]) => (
          <div class="bg-dark-800 border border-white/10 rounded-xl p-4">
            <p class="font-black text-white mb-1">{t}</p>
            <p class="text-sm text-white/70 mb-0">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-dark">
    <div class="container-wide">
      <div class="max-w-content mx-auto">
        <div class="eyebrow">Emergency Checklist</div>
        <h2>What should I do right now?</h2>
        <p class="text-lg text-white/90">
          Before the crew arrives: stop the water at its source, stay clear of standing water near
          electricity, and photograph everything for your insurance claim. Then call {brand.displayName} at
          <a href={`tel:${brand.phoneRaw}`} class="font-bold whitespace-nowrap">{brand.phone}</a>.
        </p>
        <ol class="space-y-4 mt-8">
          <li><strong>Shut off the water.</strong> Close the main shut-off valve — usually where the water line enters the house, or at the fixture that failed.</li>
          <li><strong>Cut power to affected rooms.</strong> Only if you can reach the breaker panel without stepping in water. If not, stay out and wait for help.</li>
          <li><strong>Stay out of contaminated water.</strong> Sewage backups and outdoor floodwater carry bacteria — do not wade through or touch it.</li>
          <li><strong>Document the damage.</strong> Take photos and video of every affected room before anything is moved. Your insurance adjuster will need them.</li>
          <li><strong>Move what you can.</strong> Lift furniture, rugs, and electronics out of the water if it is safe to do so.</li>
          <li><strong>Call <a href={`tel:${brand.phoneRaw}`} class="whitespace-nowrap">{brand.phone}</a>.</strong> We will walk you through the rest and get a crew moving.</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- HOW FAST CAN WE GET THERE -->
  <section class="section bg-dark">
    <div class="container-wide">
      <div class="max-w-content mx-auto">
        <div class="eyebrow">Response Time</div>
        <h2>How fast can {shortLabel} get here?</h2>
        <p class="text-lg text-white/90">
          {is247
            ? `${shortLabel} answers the phone 24/7 and crews are typically on-site within 60 minutes of your call — day or night, weekends and holidays.`
            : `${shortLabel} dispatches the nearest available crew as quickly as possible during business hours (${brand.hours}).`}
          Water damage gets worse by the hour, so we treat every call as urgent.
        </p>
        <p>We respond throughout the {brand.primaryCity} area, including:</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 max-w-4xl mx-auto mt-8">
        {areas.map((a) => (
          <a
            href={`/service-areas/${a.data.area_slug}/`}
            class="flex items-center gap-3 p-4 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 hover:border-primary/40 transition-all no-underline text-white font-bold"
          >
            <MapPin size={16} class="text-primary-400 shrink-0" />
            {a.data.city}, {a.data.state}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- INSURANCE -->
  <section class="section bg-dark">
    <div class="container-wide">
      <div class="max-w-content mx-auto">
        <div class="eyebrow">Insurance Claims</div>
        <h2>Will insurance cover this?</h2>
        <p class="text-lg text-white/90">
          Sudden, accidental water damage — a burst pipe, appliance failure, or water heater leak — is
          typically covered by homeowners insurance. {brand.displayName} works with all major carriers and
          bills your insurance company directly, so you are not stuck coordinating the claim alone.
        </p>
        <p>
          Our crew documents the entire loss for you: photos, video, itemized damage notes, and daily
          moisture readings your adjuster can verify. You pay attention to your family and your home —
          we handle the paperwork with the carrier.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT HAPPENS WHEN THE CREW ARRIVES -->
  <section class="section bg-dark">
    <div class="container-wide">
      <div class="max-w-content mx-auto">
        <div class="eyebrow">Our Process</div>
        <h2>What happens when the crew arrives?</h2>
        <p class="text-lg text-white/90">
          The crew's first job is to stop the damage from spreading: assess the loss, extract standing
          water, and get professional drying equipment running the same visit.
        </p>
        <ol class="space-y-4 mt-8">
          <li><strong>Damage assessment.</strong> We map how far the water has traveled using moisture meters — including inside walls and under floors.</li>
          <li><strong>Water extraction.</strong> Truck-mounted and portable extractors remove standing water immediately.</li>
          <li><strong>Removal of unsalvageable materials.</strong> Soaked carpet pad, drywall, and insulation that cannot be dried are removed and documented for your claim.</li>
          <li><strong>Structural drying.</strong> Commercial air movers and dehumidifiers run continuously, monitored with daily moisture readings — typically three to five days.</li>
          <li><strong>Verification and restoration.</strong> Once materials test dry, we verify with final readings and move into repairs to bring your home back to pre-loss condition.</li>
        </ol>
      </div>
    </div>
  </section>

  <FAQSection faq={faq} eyebrow="Emergency" heading="Emergency FAQs" />

  <CtaBanner
    heading={is247 ? "Water emergency? We're awake." : "Water emergency? Call us first."}
    subheading={`One call gets a crew moving — ${brand.phone}.`}
  />
</BaseLayout>
