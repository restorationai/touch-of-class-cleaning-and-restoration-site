---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CtaBanner from "~/components/CtaBanner.astro";
import FAQSection from "~/components/FAQSection.astro";
import InternalLinks from "~/components/InternalLinks.astro";
import { Phone } from "@lucide/astro";
import ServicesHubGrid from "~/components/ui/ServicesHubGrid.astro";
import ServiceAreasHubGrid from "~/components/ui/ServiceAreasHubGrid.astro";
import { brand } from "~/lib/brand";

export async function getStaticPaths() {
  // Slugs handled by dedicated route files, not by this catch-all.
  const DEDICATED = new Set(["home", "blog-index"]);
  const pages = await getCollection("pages");
  return pages
    .filter((p) => !DEDICATED.has(p.slug))
    .map((p) => ({ params: { fixed: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const archetype = data.archetype ?? entry.slug;
// Contact is the one archetype whose hero exists only to say where you
// are; the form beneath it is the point of the page, so it gives up the
// height it was spending on a 3-line h1 and lets the fields clear the fold.
const isContact = archetype === "contact";
const heroImage = data.hero || "/images/hero-bg.webp" /* preview: switch to `${brand.imagesBase}/brand/...` at production cutover */;
// Hub archetypes get a visual link grid above the prose; the full prose is
// retained below it (SEO: keep all text content, the grid only ADDS
// descriptive-anchor internal links).
const proseHeading =
  archetype === "services-hub"
    ? "More About Our Services"
    : archetype === "service-areas-hub"
      ? "More About the Areas We Serve"
      : null;
---

<BaseLayout
  title={data.title}
  meta_description={data.meta_description}
  hero_image_url={heroImage}
  schema_stubs={["organization", "website", "local-business", "faq", "breadcrumb-list"]}
  schema_ctx={{ archetype }}
  breadcrumb={data.breadcrumb}
  faq={data.faq}
>
  <!-- COMPACT HERO -->
  <section class={`relative ${isContact ? "min-h-[200px]" : "min-h-[350px]"} flex items-center overflow-hidden bg-white border-b border-dark/10`}>
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt={data.h1} class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/70 to-white/20"></div>
    </div>
    <div class={`container-wide relative z-10 ${isContact ? "py-8" : "py-16"}`}>
      <div class="max-w-2xl">
        <div class="eyebrow">{archetype.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase())}</div>
        <h1 class={isContact ? "text-3xl md:text-4xl" : undefined}>{data.h1}</h1>
        <p class={`text-lg text-dark/85 mb-0 leading-relaxed max-w-xl ${isContact ? "mt-3" : "mt-6"}`}>{data.meta_description}</p>
      </div>
    </div>
  </section>

  {archetype === "services-hub" && <ServicesHubGrid />}
  {archetype === "service-areas-hub" && <ServiceAreasHubGrid />}

  {/* Contact page is optimized for direct calls, not lead-capture forms
      (Amin 2026-09-08: "Forms are ineffective for emergency restoration;
      the site is optimized for direct calls."). id="estimate" keeps the
      existing /contact/#estimate CTAs scrolling to this call panel. */}
  {archetype === "contact" && (
    <section id="estimate" class="scroll-mt-24 bg-dark-50 border-y border-dark/10 py-20">
      <div class="container-wide px-6">
        <div class="mx-auto max-w-3xl bg-dark-900 rounded-2xl shadow-xl border border-dark/10 p-8 sm:p-12 text-center">
          <p class="text-primary-400 text-xs font-black uppercase tracking-[0.2em] mb-3">24/7 Emergency Response</p>
          <h2 class="font-black uppercase tracking-tighter text-white text-3xl md:text-4xl mb-4">Call Us Now</h2>
          <p class="text-white/75 text-lg max-w-xl mx-auto mb-8">
            The fastest way to get help is a phone call — a live person answers,
            gets the details, and dispatches a crew. No forms, no waiting on a callback.
          </p>
          <a href={`tel:${brand.phoneRaw}`} class="inline-flex items-center justify-center gap-3 bg-primary-600 text-white font-black text-2xl md:text-3xl px-10 py-5 rounded-xl shadow-lg hover:bg-primary-700 transition-colors no-underline">
            <Phone size={26} strokeWidth={2.5} /> {brand.phone}
          </a>
          <p class="mt-6 mb-0 text-white/60">
            Prefer email? <a href={`mailto:${brand.email}`} class="font-bold text-white no-underline break-all">{brand.email}</a>
          </p>
          <p class="mt-2 mb-0 text-white/60 text-sm">
            Serving {brand.primaryCity}, {brand.primaryState} and surrounding communities.
          </p>
          {brand.trustBadges.length > 0 && (
            <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2.5">
              {brand.trustBadges.map((b) => (
                <li class="flex items-center gap-2 font-semibold text-sm text-white/90">
                  <span class="text-primary-400 font-black">✓</span> {b}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- BODY -->
  <section class="section-first bg-white">
    <div class="container-wide">
      <div class="prose-body">
        {proseHeading && <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter">{proseHeading}</h2>}
        <Content />
      </div>
    </div>
  </section>


  <FAQSection faq={data.faq} />

  <CtaBanner />

  <InternalLinks paths={data.internal_links} heading="Keep Exploring" />
</BaseLayout>
