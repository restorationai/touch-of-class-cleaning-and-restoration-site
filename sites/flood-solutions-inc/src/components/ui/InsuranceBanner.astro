---
/* FFS variant (Santino 2026-09-25): white background, tighter padding.
   Copy note: "handle the claim paperwork" is BANNED for this client (Will's
   review doc — they legally cannot handle claims; they converse with the
   carrier and provide paperwork), so the subline says "work with your
   carrier" instead. Protected via .rank-ai/protected-paths.txt. */
import { ShieldCheck } from '@lucide/astro';
---

<div class="bg-white border-y border-gray-200 py-3 px-4">
  <div class="max-w-3xl mx-auto flex flex-col items-center gap-2 text-center">
    <span class="rounded-full bg-[#1273b8]/10 p-2 text-[#1273b8]">
      <ShieldCheck size={24} />
    </span>
    <div>
      <p class="text-lg sm:text-xl font-extrabold tracking-tight text-dark-900 uppercase">
        We work with all insurance carriers
      </p>
      <p class="mt-0.5 text-sm font-medium text-dark-500">
        Direct insurance billing &middot; We work with your carrier from start to finish
      </p>
    </div>
  </div>
</div>
