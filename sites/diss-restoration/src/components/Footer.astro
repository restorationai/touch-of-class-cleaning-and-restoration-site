---
import { brand } from "~/lib/brand";
import { getCollection } from "astro:content";

const is247 = /24\s*[\/x-]?\s*7|24 ?hours/i.test(String(brand.hours || ""));
const services = (await getCollection("services")).sort((a, b) => (b.data.priority || 0) - (a.data.priority || 0));
const areas = (await getCollection("serviceAreas")).sort((a, b) => Number(b.data.primary) - Number(a.data.primary));
const year = new Date().getFullYear();
const FB_ICON = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.09 24 18.1 24 12.07z"/></svg>`;
const IG_ICON = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 0 1-.9 1.38c-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.39A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.73 1.46 1.39 2.13a5.9 5.9 0 0 0 2.13 1.39c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.39 5.9 5.9 0 0 0 1.39-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.39-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.15A3.99 3.99 0 1 1 16 12a3.99 3.99 0 0 1-4 3.99zm7.85-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44z"/></svg>`;
---

<footer class="bg-white text-navy-900 pt-24 pb-12 mt-0">
  <div class="container-wide grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      {brand.logoUrl && (
        <img src={brand.logoUrl} alt={`${brand.displayName} logo`} class="h-16 md:h-20 w-auto mb-6" width="48" height="48" loading="lazy" />
      )}
      <div class="font-display text-2xl font-black tracking-tight text-navy-900">{brand.displayName}</div>
      <p class="mt-4 text-navy-900/70 text-sm leading-relaxed mb-0">{brand.tagline}</p>
      <address class="not-italic mt-6 text-sm text-navy-900/80 leading-relaxed">
        <div>{brand.streetAddress}</div>
        <div>{brand.addressCity}, {brand.addressState} {brand.postalCode}</div>
        <div class="mt-3"><a href={`tel:${brand.phoneRaw}`} class="text-primary font-bold no-underline hover:underline">{brand.phone}</a></div>
        <div><a href={`mailto:${brand.email}`} class="text-primary no-underline hover:underline">{brand.email}</a></div>
      </address>
      {(() => {
        // Social profiles from sameAsUrls (Fran/QCI 2026-09-05): render only
        // recognized social platforms — directories (Yelp, BBB, maps) stay
        // schema-only. Labels double as accessible names.
        const socials = (brand.sameAsUrls || []).map((u) => {
          const m = u.match(/(facebook|instagram|linkedin|youtube|twitter|x)\.com/i);
          if (!m) return null;
          const key = m[1].toLowerCase();
          const label = { facebook: "Facebook", instagram: "Instagram", linkedin: "LinkedIn", youtube: "YouTube", twitter: "X", x: "X" }[key];
          return { u, label };
        }).filter(Boolean) as { u: string; label: string }[];
        return socials.length ? (
          <div class="flex gap-3 mt-5">
            {socials.map((s2) => (
              <a href={s2.u} target="_blank" rel="noopener noreferrer" aria-label={`${brand.displayName} on ${s2.label}`}
                 class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-navy-900/15 text-xs font-bold text-navy-900/70 no-underline hover:text-primary hover:border-primary transition-colors">
                <Fragment set:html={{ facebook: FB_ICON, instagram: IG_ICON }[s2.label.toLowerCase()] || ""} />
                {s2.label}
              </a>
            ))}
          </div>
        ) : null;
      })()}
    </div>

    <div class="lg:col-span-3">
      <div class="text-xs font-black uppercase tracking-widest text-navy-900 mb-4">Services</div>
      <ul class="space-y-2 text-sm list-none pl-0">
        {services.slice(0, 8).map((s) => (
          <li>
            <a href={`/services/${s.data.service_slug}/`} class="text-navy-900/70 hover:text-primary no-underline transition-colors">
              {s.data.service_display}
            </a>
          </li>
        ))}
        {services.length > 8 && (
          <li>
            <a href="/services/" class="text-primary font-semibold no-underline hover:underline">See all services →</a>
          </li>
        )}
      </ul>
    </div>

    <div class="lg:col-span-3">
      <div class="text-xs font-black uppercase tracking-widest text-navy-900 mb-4">Service Areas</div>
      <ul class="space-y-2 text-sm list-none pl-0">
        {areas.slice(0, 10).map((a) => (
          <li>
            <a href={`/service-areas/${a.data.area_slug}/`} class="text-navy-900/70 hover:text-primary no-underline transition-colors">
              {a.data.city}, {a.data.state}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-2">
      <div class="text-xs font-black uppercase tracking-widest text-navy-900 mb-4">Company</div>
      <ul class="space-y-2 text-sm list-none pl-0">
        <li><a href="/emergency/" class="text-primary font-bold no-underline hover:underline">{is247 ? "24/7 Emergency" : "Emergency"}</a></li>
        <li><a href="/about/" class="text-navy-900/70 hover:text-primary no-underline">About</a></li>
        <li><a href="/reviews/" class="text-navy-900/70 hover:text-primary no-underline">Reviews</a></li>
        <li><a href="/certifications/" class="text-navy-900/70 hover:text-primary no-underline">Certifications</a></li>
        <li><a href="/contact/" class="text-navy-900/70 hover:text-primary no-underline">Contact</a></li>
        <li><a href="/case-studies/" class="text-navy-900/70 hover:text-primary no-underline">Case Studies</a></li>
        <li><a href="/blog/" class="text-navy-900/70 hover:text-primary no-underline">Blog</a></li>
        <li><a href="/privacy/" class="text-navy-900/70 hover:text-primary no-underline">Privacy</a></li>
        <li><a href="/terms/" class="text-navy-900/70 hover:text-primary no-underline">Terms</a></li>
        <li><a href="/accessibility/" class="text-navy-900/70 hover:text-primary no-underline">Accessibility</a></li>
      </ul>
    </div>
  </div>

  <div class="container-wide mt-16 pt-8 border-t border-navy-900/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-navy-900/70">
    <div>© {year} {brand.legalName}{brand.dbaName ? `, doing business as ${brand.dbaName}` : ""}. All rights reserved.</div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span>{brand.licenseType}</span>
      <span class="text-navy-900/70" aria-hidden="true">·</span>
      <span>{brand.licenseAuthority}</span>
      {brand.licenseNumbers && Array.isArray(brand.licenseNumbers) && brand.licenseNumbers.length > 0 && (
        <>
          <span class="text-navy-900/70" aria-hidden="true">·</span>
          {(brand as { licenseLookupUrl?: string }).licenseLookupUrl ? (
            <a href={(brand as { licenseLookupUrl?: string }).licenseLookupUrl}
               target="_blank" rel="noopener nofollow"
               class="underline decoration-dotted underline-offset-2 hover:opacity-80"
               title="Verify this license with the state">
              #{brand.licenseNumbers.join(", #")}
            </a>
          ) : (
            <span>#{brand.licenseNumbers.join(", #")}</span>
          )}
        </>
      )}
    </div>
  </div>
</footer>
