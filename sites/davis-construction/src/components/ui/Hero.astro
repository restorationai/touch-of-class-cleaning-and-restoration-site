---
// src/components/ui/Hero.astro
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  isSensitive?: boolean;
  backgroundImage?: string;
}

const { title, subtitle, ctaText = "Get Help Now", ctaLink = "tel:18001234567", isSensitive = false, backgroundImage } = Astro.props;
---

<header class="relative section-cta">
  {/* Background image or solid dark color */}
  {backgroundImage ? (
    <div class="absolute inset-0 z-0">
      <img src={backgroundImage} alt="Background" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-dark-900/80"></div>
    </div>
  ) : (
    <div class="absolute inset-0 bg-dark z-0"></div>
  )}
  
  <div class="absolute inset-0 bg-gradient-to-br from-dark-900/90 to-dark-800/80 z-0"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white/5 to-transparent z-0"></div>

  <div class="container-narrow relative z-10 text-center py-20">
    <h1 class="mb-6 drop-shadow-lg">{title}</h1>
    {subtitle && <p class="text-xl md:text-2xl text-white/90 mb-10 drop-shadow-md">{subtitle}</p>}
    <a href={ctaLink} class={isSensitive ? "btn-muted text-lg px-8 py-4 shadow-xl" : "btn-primary text-lg px-8 py-4 shadow-xl"}>
      {ctaText}
    </a>
  </div>
</header>
