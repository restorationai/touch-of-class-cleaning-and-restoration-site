        <div class="mt-9 max-w-3xl mx-auto card p-2 sm:p-3">
          <iframe src={BOOK_URL} title="Book your free Rank AI audit"
            style="width:100%; min-height:720px; border:none; overflow:hidden;" scrolling="no" loading="lazy" id="rankai-booking"></iframe>
        </div>
        <p class="mt-5 text-center text-sm text-slate-400">Prefer email? <a href={EMAIL} class="text-brand-600 font-semibold hover:text-brand-500">contact@restorationai.io</a></p>
      </div>
    </section>
    <script is:inline src="https://link.restorationai.io/js/form_embed.js" type="text/javascript"></script>

    <!-- Footer -->
    <footer class="border-t border-slate-100 bg-white">
      <div class="max-w-wide mx-auto px-5 py-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-1">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center font-black text-white">R</span>
            <span class="font-black text-slate-900">Rank AI</span>
          </div>
          <p class="text-xs text-slate-400 mt-3 leading-relaxed">AI search & local visibility for restoration companies. By Restoration AI.</p>
