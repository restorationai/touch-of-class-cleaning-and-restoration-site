---
import { ArrowRightCircle } from '@lucide/astro';
import { brand } from '~/lib/brand';
import { serviceImage, srcsetFor } from '~/lib/images';
import { getCollection, type CollectionEntry } from 'astro:content';

type Props = {
  services: CollectionEntry<'services'>[];
};

const { services } = Astro.props;

// every rendered service, highest priority first (home-city link list below)
const homeCityServices = (await getCollection('services'))
  .filter((s) => s.data.service_slug && (s.data as any).rendered !== false)
  .sort((a, b) => ((b.data as any).priority || 0) - ((a.data as any).priority || 0));
---

<section class="bg-dark py-16 text-white">
  <div class="container-wide px-6 sm:px-10 lg:px-12">
    {/* Section Header matching reference */}
    <div class="mb-10">
      <div class="inline-block bg-black px-4 py-2 mb-4">
        <span class="text-white text-sm font-black uppercase tracking-widest">What we are best at</span>
      </div>
      <div class="flex items-center gap-6">
        <h2 class="text-4xl sm:text-5xl md:text-7xl font-black uppercase tracking-tighter whitespace-nowrap">Our Services</h2>
        <div class="flex-grow h-0.5 bg-white/20"></div>
      </div>
    </div>

    {/* Services Grid with spacing and individual borders */}
    <div class="flex flex-wrap justify-center gap-10">
      {services.map((s) => {
        // Fallback to brand hero image if no service hero is defined
        const imageUrl = s.data.hero || serviceImage(s.data.service_slug, `${brand.imagesBase}/brand/hero.webp`);
        const img = srcsetFor(imageUrl);

        return (
          <a 
            href={`/services/${s.data.service_slug}/`}
            class="group relative h-[260px] w-full md:w-[calc((100%-40px)/2)] lg:w-[calc((100%-80px)/3)] border-4 border-white/10 shadow-2xl overflow-hidden cursor-pointer transform transition-transform hover:-translate-y-2"
          >
            {/* Photo */}
            <img
              src={imageUrl}
              srcset={img.srcset}
              sizes={img.srcset ? "(min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw" : undefined}
              width={img.width}
              height={img.height}
              alt={s.data.service_display}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />

            
            {/* Bottom banner containing the text box */}
            <div class="absolute bottom-6 left-6 right-6">
              <div class="flex items-center justify-between bg-black text-white px-6 py-5 font-black uppercase text-xl border border-white/10 shadow-xl group-hover:bg-cta group-hover:text-cta-fg transition-colors duration-300">
                <span class="tracking-tighter line-clamp-2">{s.data.service_display}</span>
                <ArrowRightCircle size={32} class="text-primary-500 group-hover:text-white transition-colors shrink-0" />
              </div>
            </div>
          </a>
        );
      })}
    </div>
      {/* ALL SERVICES IN THE HOME CITY (Santino 2026-10-02): every service page
        is the "{service} in {home city}" page; the cards above only feature
        the pinned core set, so this list gives each one a city-anchored link
        from the homepage. Inherits the section's text colour (light + dark). */}
    {homeCityServices.length > 0 && (
      <div class="mt-12">
        <h3 class="text-sm font-black uppercase tracking-widest mb-4" style="color: inherit; opacity: .8">All our services in {brand.primaryCity}</h3>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none p-0 m-0">
          {homeCityServices.map((s) => (
            <li><a href={`/services/${s.data.service_slug}/`} class="underline decoration-1 underline-offset-4 hover:opacity-100" style="color: inherit; opacity: .85">{s.data.service_display} in {brand.primaryCity}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
