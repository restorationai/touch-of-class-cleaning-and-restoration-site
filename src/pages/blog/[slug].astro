---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CtaBanner from "~/components/CtaBanner.astro";
import FAQSection from "~/components/FAQSection.astro";
import InternalLinks from "~/components/InternalLinks.astro";
import { brand } from "~/lib/brand";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const heroImage = data.hero || `${brand.imagesBase}/brand/hero.webp`;
const dateStr = new Date(data.published_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
// E-E-A-T byline (2026-10-03): named author when one is on file, else the
// business; the name links to /about/, the business to the homepage.
// Credentials print only when brand.ts holds them (never invented).
const updatedStr = data.updated_at && data.updated_at !== data.published_at
  ? new Date(data.updated_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })
  : "";
// displayName, not dbaName: a keyword-style GBP name reads as spam in a byline
const bizName = brand.displayName;
const authorName = (data as any).author || "";
const credentials = [
  ...(((brand as any).licenseNumbers || []) as string[]).filter(Boolean)
    .map((n) => `License #${String(n).replace(/^#/, "")}`),
  ...(((brand as any).certifications || []) as string[]).filter(Boolean),
].slice(0, 3);
---

<BaseLayout
  title={data.title}
  meta_description={data.meta_description}
  hero_image_url={heroImage}
  schema_stubs={["blog-posting", ...(data.youtube_id ? ["video-object"] : []), "faq", "breadcrumb-list"]}
  schema_ctx={{
    archetype: "blog-post",
    post_published_at: data.published_at,
    post_updated_at: data.updated_at,
    author_name: (data as any).author,
    youtube_id: data.youtube_id,
    video_transcript: data.video_transcript,
  }}
  breadcrumb={data.breadcrumb}
  faq={data.faq}
>
  <!-- ARTICLE HEADER -->
  <section class="relative min-h-[420px] flex items-end overflow-hidden bg-navy border-b border-white/10">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt={data.title} class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/85 to-navy/40"></div>
    </div>
    <div class="container-wide relative z-10 py-16 max-w-4xl">
      <div class="eyebrow"><time datetime={data.published_at}>{dateStr}</time></div>
      <h1 class="mb-0">{data.title}</h1>
      <p class="mt-4 mb-0 text-sm md:text-base opacity-90" data-byline>
        By <a href="/about/" rel="author" class="underline">{authorName || bizName}</a>
        {authorName && <> of <a href="/" class="underline">{bizName}</a></>}
        {updatedStr && <><span aria-hidden="true"> · </span><time datetime={data.updated_at}>Updated {updatedStr}</time></>}
        {credentials.length > 0 && <><span aria-hidden="true"> · </span>{credentials.join(", ")}</>}
      </p>
    </div>
  </section>

  <!-- ARTICLE BODY -->
  <article class="section-first bg-navy">
    <div class="container-wide max-w-3xl mx-auto">
      {data.youtube_id && (
        <div class="mb-10 rounded-xl overflow-hidden border border-white/10 shadow-2xl aspect-video">
          <iframe
            src={`https://www.youtube.com/embed/${data.youtube_id}`}
            title={data.title}
            width="100%"
            height="100%"
            style="border:0;display:block;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      )}
      <div class="prose-body">
        <Content />
      </div>
    </div>
  </article>

  <FAQSection faq={data.faq} />

  <CtaBanner heading="Need help with a similar situation?" subheading="Call us 24/7. We answer the phone." />

  <InternalLinks paths={data.internal_links} heading="Related Reading" eyebrow="More Resources" />
</BaseLayout>
